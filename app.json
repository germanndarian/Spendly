{
  "expo": {
    "name": "Spendly",
    "slug": "Spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spendly-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dariangermann.spendly"
    },
    "android": {
      "package": "com.dariangermann.spendly",
      "adaptiveIcon": {
        "backgroundColor": "#1F5A45",
        "foregroundImage": "./assets/spendly-foreground.png",
        "monochromeImage": "./assets/spendly-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/spendly-favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/spendly-splash.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F5F1",
          "dark": {
            "backgroundColor": "#121413",
            "image": "./assets/spendly-foreground.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Spendly verwendet Face ID, damit nur du deine Ausgaben sehen kannst."
        }
      ]
    ],
    "backgroundColor": "#F6F5F1"
  }
}
